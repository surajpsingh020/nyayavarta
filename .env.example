# ===========================================
# Nyayavarta Environment Configuration
# ===========================================
# Copy this file to .env and fill in your keys.

# --- BHASHINI API (https://bhashini.gov.in/ulca) ---
BHASHINI_UDYAT_KEY=your_bhashini_udyat_api_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_api_key_here

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Neo4j Knowledge Graph ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nyayavarta_secret_2024
NEO4J_DATABASE=neo4j

# --- Frontend (optional) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend Settings (optional overrides) ---
# GEMINI_MODEL=gemini-1.5-flash
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TOP_K_RESULTS=5
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# FRONTEND_URL=http://localhost:3000
